          "name": "chk_upload_sessions_finalize_pair",
          "value": "(`upload_sessions`.`computed_sha256` IS NULL AND `upload_sessions`.`finalize_started_at` IS NULL) OR (`upload_sessions`.`computed_sha256` IS NOT NULL AND `upload_sessions`.`finalize_started_at` IS NOT NULL)"
