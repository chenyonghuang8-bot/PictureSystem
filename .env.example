NODE_ENV=development
APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=4000
API_PUBLIC_ORIGIN=https://localhost:4000
TRUSTED_WEB_ORIGINS=https://localhost:3000
TRUSTED_PROXY_CIDRS=
WEB_PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://family_album_dev_user:replace_with_dev_password@127.0.0.1:3306/family_album_dev
DEV_MEDIA_ROOT=./data/dev/media
DEV_STORAGE_MARKER_ID=
DEV_TEMP_UPLOAD_ROOT=./data/dev/temp-uploads

# Optional, local-only validated coarse location dataset. Never auto-updated.
LOCATION_DATA_DIR=./resources/location/2026-10-03
# Set disabled to avoid all external basemap requests. Hosted provider exposes viewport/IP.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# DEV only: attach receipt reconciliation + serial derivatives to API writer.
DEV_MEDIA_PIPELINE_ENABLED=0

# Phase 11: explicitly provisioned DEV-only control namespace. Normal startup
# never creates it. Use a canonical private system-tmp path or .cache subdir.
DEV_CONTROL_PATH=/private/tmp/family-album-dev-control
DEV_CONTROL_DEPLOYMENT_ID=11111111-1111-4111-8111-111111111111
# Optional deployment-wide critical roles, identical in API/worker environments.
# Include only processes actually configured; absence/staleness blocks recovery.
DEV_CONTROL_REQUIRED_ROLES=API
