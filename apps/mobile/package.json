{
  "name": "@family-album/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform web --output-dir dist",
    "dev": "expo start",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build:android:debug": "expo run:android --variant debug"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@family-album/contracts": "workspace:*",
    "@family-album/ui-tokens": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system"
        ]
      }
    }
  }
}
