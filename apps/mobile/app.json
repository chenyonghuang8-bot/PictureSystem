{
  "expo": {
    "name": "嘟嘟家庭相册",
    "slug": "family-album",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "familyalbum",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "./plugins/with-private-android.cjs"
    ],
    "android": {
      "package": "local.familyalbum.app",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
